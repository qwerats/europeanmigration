AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Быстрее на CPU: llama3.2:3b (ollama pull llama3.2:3b). Точнее, но медленнее: llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
# Лимит токенов ответа (меньше = быстрее). По умолчанию 900.
# OLLAMA_NUM_PREDICT=900
# OLLAMA_NUM_CTX=3072
# OLLAMA_KEEP_ALIVE=30m

# Кэш HTML Eurostat/IOM (мс). По умолчанию 30 мин. Stale-кэш отдаётся мгновенно.
# MIGRATION_SOURCES_CACHE_MS=1800000

# Optional paid fallback:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
